#include <SimpleFOC.h>

// 1. Hardware Instances (from your configuration)
// NEMA 17 Stepper Motor: 50 pole pairs, Phase Resistance: 3.5 ohm, KV: 41.6
StepperMotor motor = StepperMotor(50, 3.5, 41.6);
StepperDriver4PWM driver = StepperDriver4PWM(18, 19, 33, 25, 26, 27);

// AS5600 I2C Sensor
MagneticSensorI2C sensor = MagneticSensorI2C(AS5600_I2C);

// Commander instance for optional real-time debugging
Commander command = Commander(Serial);
void doMotor(char* cmd) { command.motor(&motor, cmd); }

void setup() {
  // Initialize Serial Monitor
  Serial.begin(115200);
  while (!Serial);

  // Enable verbose debugging output to track sensor alignment steps
  SimpleFOCDebug::enable(&Serial);

  // Initialize I2C (ESP32 pins SDA: 21, SCL: 22) and sensor
  Wire.begin(21, 22);
  Wire.setClock(400000); // 400kHz I2C clock speed for fast readings
  sensor.init(&Wire);
  motor.linkSensor(&sensor);

  // Initialize Driver
  driver.voltage_power_supply = 12.0; // Adjust to match your power supply voltage (e.g., 12V or 24V)
  driver.voltage_limit = 12;         // Max voltage allowed to driver
  driver.init();
  motor.linkDriver(&driver);

  // Alignment Voltage Configuration
  // CAUTION: Steppers have low phase resistance. Set this conservatively (e.g., 1.5V - 3.0V)
  // so the motor can hold position without excessive heating or drawing high current.
  motor.voltage_sensor_align = 12; 

  // Select Open-Loop/Voltage control mode for alignment check
  motor.controller = MotionControlType::angle;
  motor.torque_controller = TorqueControlType::voltage;

  // Initialize Motor
  motor.init();

  // Run Alignment Routine: Detects direction, validates pole pairs, and finds zero electrical angle
  Serial.println("\n--- Starting Sensor Alignment & Pole Pair Verification ---");
  int success = motor.initFOC();

  if (success) {
    Serial.println("\n==========================================");
    Serial.println(" Alignment Successful!");
    Serial.print(" Sensor Direction      : ");
    Serial.println(motor.sensor_direction == Direction::CW ? "CW" : "CCW");
    Serial.print(" Measured Zero Angle   : ");
    Serial.print(motor.zero_electric_angle);
    Serial.println(" rad");
    Serial.print(" Pole Pair Check Status: ");
    Serial.println(motor.pp_check_result ? "PASSED" : "WARNING - Pole pair mismatch detected!");
    Serial.println("==========================================");
  } else {
    Serial.println("\n[ERROR] FOC Alignment failed! Check power supply, wiring, or alignment voltage.");
  }

  // Add motor command to Commander
  command.add('M', doMotor, "motor");
}

void loop() {
  // Maintain FOC execution loop
  motor.loopFOC();
  motor.move();

  // Process any serial commands
  command.run();
}